{
  "ai": {
    "provider": "openai",
    "model": "gemini-3.1-flash-lite",
    "api_key_env": "GOOGLE_API_KEY",
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 2,
    "analysis_concurrency": 2,
    "enrichment_concurrency": 2,
    "languages": [
      "zh",
      "en"
    ]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 6.5,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 5,
        "topic_dedup": false
      },
      "ai-creator": {
        "threshold": 6,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_enabled": false,
    "imap_server": "",
    "imap_port": 993,
    "email_address": "2166075979@qq.com",
    "password_env": "EMAIL_PASSWORD",
    "sender_name": "AI Daily Horizon",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },

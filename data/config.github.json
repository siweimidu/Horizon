  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 24,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "ai-creator"
    ],
    "category_groups": {
      "zh-media": {
        "limit": 5,
        "categories": [
          "zh-media"
        ]
      },
      "lab-official": {
        "limit": 5,
        "categories": [
          "lab-official"
        ]
      },
      "lab-blog": {
        "limit": 4,
        "categories": [
          "lab-blog"
        ]
      },
      "paper": {
        "limit": 3,
        "categories": [
          "paper"
        ]
      },
      "digest": {
        "limit": 3,
        "categories": [
          "digest"
        ]
      },
      "community": {
        "limit": 3,
        "categories": [
          "community"
        ]
      },
      "media": {
        "limit": 2,
        "categories": [
          "media"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 3
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "text": "#{message_title}\n\n#{summary?limit=3500&split=---}",
      "parse_mode": "Markdown"
    },
    "headers": "Content-Type: application/json"
  },
  "wechat": {
    "enabled": false,
    "languages": [
      "zh"
    ],
    "chunk_size": 4000
  }
